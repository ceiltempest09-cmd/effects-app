// @id rt_vibrant_glow_particles
// @name Ray Traced 3D Vibrant Glow Particles
// @category 3d
// @description A ray-marched volumetric field of animated neon particles with orbiting motion, depth variation and HDR-style emissive color.
// @param particleColorA color #20d9ff label="Primary Particle Color"
// @param particleColorB color #ff35c7 label="Secondary Particle Color"
// @param particleColorC color #b7ff3c label="Accent Particle Color"
// @param particleSize float 0.075 min=0.015 max=0.18 step=0.005 label="Particle Size"
// @param particleDensity float 1.0 min=0.25 max=1.5 step=0.01 label="Particle Density"
// @param spread float 1.15 min=0.45 max=2.0 step=0.01 label="Particle Spread"
// @param speed float 0.65 min=0 max=2.5 step=0.01 label="Animation Speed"
// @param orbitAmount float 0.32 min=0 max=0.8 step=0.01 label="Orbit Motion"
// @param turbulence float 0.45 min=0 max=1.5 step=0.01 label="Turbulence"
// @param glowIntensity float 2.8 min=0.2 max=6.0 step=0.05 label="Glow Intensity"
// @param twinkle float 0.65 min=0 max=1 step=0.01 label="Twinkle"
// @param coreGlow float 0.35 min=0 max=2 step=0.01 label="Central Energy Glow"

uniform vec4 particleColorA;
uniform vec4 particleColorB;
uniform vec4 particleColorC;
uniform float particleSize;
uniform float particleDensity;
uniform float spread;
uniform float speed;
uniform float orbitAmount;
uniform float turbulence;
uniform float glowIntensity;
uniform float twinkle;
uniform float coreGlow;

float hash31(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

vec3 hash33(vec3 p) {
    float n = hash31(p);
    return vec3(n, hash31(p + 17.17), hash31(p + 41.73));
}

float particleField(vec3 p, out float particleId, out float pulse) {
    float nearest = 100.0;
    particleId = 0.0;
    pulse = 0.0;

    // A bounded 3D lattice keeps the ray-marched workload predictable.
    for (int z = -1; z <= 1; z++) {
        for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
                vec3 cell = vec3(float(x), float(y), float(z));
                vec3 rnd = hash33(cell + vec3(8.31, 3.17, 5.73));

                float phase = time * speed * (0.65 + rnd.x * 1.1) + rnd.y * 6.28318;
                vec3 basePos = cell * spread;
                vec3 drift = vec3(
                    sin(phase + rnd.z * 4.0),
                    cos(phase * 0.83 + rnd.x * 5.0),
                    sin(phase * 0.71 + rnd.y * 6.0)
                ) * orbitAmount;

                vec3 wave = vec3(
                    sin(p.y * 2.4 + phase),
                    cos(p.z * 2.1 - phase * 0.7),
                    sin(p.x * 2.2 + phase * 0.6)
                ) * (turbulence * 0.10);

                vec3 center = basePos + drift + wave;
                float phasePulse = 0.72 + 0.28 * sin(time * speed * (1.2 + rnd.z) + rnd.x * 12.0);
                float radius = particleSize * particleDensity * mix(0.62, 1.28, rnd.z);
                radius *= mix(1.0, phasePulse, twinkle);

                float d = length(p - center) - radius;
                if (d < nearest) {
                    nearest = d;
                    particleId = rnd.x;
                    pulse = phasePulse;
                }
            }
        }
    }
    return nearest;
}

float map(vec3 p) {
    float id;
    float pulse;
    float particles = particleField(p, id, pulse);

    // A subtle central energy volume gives the particle cloud a focal point.
    float core = length(p * vec3(0.88, 1.0, 0.88)) - (0.16 + coreGlow * 0.055);
    return min(particles, core);
}

vec3 material(vec3 p, vec3 n, vec2 uv, out float refl) {
    float particleId;
    float pulse;
    float particleD = particleField(p, particleId, pulse);

    float coreD = length(p * vec3(0.88, 1.0, 0.88)) - (0.16 + coreGlow * 0.055);
    float isCore = 1.0 - smoothstep(-0.025, 0.025, coreD - particleD);

    vec3 colorAB = mix(particleColorA.rgb, particleColorB.rgb, smoothstep(0.18, 0.82, particleId));
    vec3 particleColor = mix(colorAB, particleColorC.rgb, smoothstep(0.72, 0.98, particleId));
    float shimmer = 0.78 + 0.22 * sin(time * speed * 3.0 + particleId * 31.0);
    float rim = pow(1.0 - clamp(abs(dot(normalize(n), normalize(-p))), 0.0, 1.0), 2.0);

    vec3 particleEmission = particleColor * glowIntensity * pulse * shimmer;
    vec3 coreColor = mix(particleColorA.rgb, particleColorC.rgb, 0.5 + 0.5 * sin(time * speed));
    vec3 coreEmission = coreColor * glowIntensity * (1.0 + coreGlow * 1.8) * (0.8 + rim * 0.7);

    refl = mix(0.18, 0.48, isCore);
    return mix(particleEmission, coreEmission, isCore);
}
