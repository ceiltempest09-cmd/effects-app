// @id rtglow
// @name RayTraced Energy Glow
// @category 3d
// @description Floating emissive 3D energy forms with bright colored surfaces and reflective response.
// @param radius float 0.48 min=0.1 max=0.9 step=0.01 label="Core Size"
// @param pulse float 1 min=0 max=4 step=0.01 label="Pulse Speed"
// @param intensity float 2.2 min=0.1 max=5 step=0.01 label="Emission Intensity"
// @param color color #55dfff label="Energy Color"
// @param secondary color #b45cff label="Secondary Color"
// @param orbit float 0.65 min=0 max=3 step=0.01 label="Orbit Speed"
uniform float radius;
uniform float pulse;
uniform float intensity;
uniform vec4 color;
uniform vec4 secondary;
uniform float orbit;

float map(vec3 p) {
    float t = time * orbit;
    float beat = 1.0 + 0.08 * sin(time * pulse * 6.2831853);
    float d = 100.0;
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float a = t + fi * 1.25663706;
        vec3 c = vec3(cos(a) * 0.85, 0.12 * sin(a * 1.7 + fi), sin(a) * 0.85);
        float r = radius * beat * (0.55 + 0.12 * mod(fi, 3.0));
        d = min(d, length(p - c) - r);
    }
    return d;
}

vec3 material(vec3 p, vec3 n, vec2 uv, out float refl) {
    float t = time * orbit;
    float band = 0.5 + 0.5 * sin(atan(p.z, p.x) * 5.0 + p.y * 9.0 - t * 3.0);
    vec3 col = mix(color.rgb, secondary.rgb, band);
    float rim = pow(1.0 - abs(dot(normalize(n), normalize(vec3(0.25, 0.35, -1.0)))), 2.0);
    refl = 0.28;
    return col * intensity * (1.0 + rim * 0.8);
}
